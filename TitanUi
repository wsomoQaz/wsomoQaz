-- MultiDropdown ----------------------------------------------------- function Section:MultiDropdown(opts) opts = opts or {} local title = tostring(opts.Title or "MultiDropdown") local items = opts.Items or { "A", "B", "C", "D" } local defaults = {} for _, d in ipairs(opts.Defaults or {}) do defaults[d] = true end local cb = opts.Callback

local holder = baseControl(self, 56)
local left = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -180, 1, 0) })
left.Parent = holder
makeLabel(left, title, 14, self.Tab.Window.Theme.Text)

local right = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 180, 1, 0) })
right.Parent = holder

local box = newInstance("TextButton", {
	BackgroundColor3 = self.Tab.Window.Theme.Card2, AutoButtonColor = false, Text = "选择...",
	Font = self.Tab.Window.Theme.Font, TextSize = 14, TextColor3 = self.Tab.Window.Theme.Text, Size = UDim2.new(1, 0, 0, 28),
})
corner(self.Tab.Window.Theme.Corner).Parent = box
stroke(applyTransparency(self.Tab.Window.Theme.Stroke, 0.2), 1, 0.35).Parent = box
box.Parent = right

local list = newInstance("Frame", { BackgroundColor3 = self.Tab.Window.Theme.Card, BorderSizePixel = 0, Visible = false })
corner(self.Tab.Window.Theme.Corner).Parent = list
stroke(applyTransparency(self.Tab.Window.Theme.Stroke, 0.2), 1, 0.35).Parent = list
list.Parent = holder
local lst = listLayout(Enum.FillDirection.Vertical, 0); lst.Parent = list

local selected = {}
for k, v in pairs(defaults) do selected[k] = v end

local function updateText()
	local t = {}
	for _, it in ipairs(items) do if selected[it] then table.insert(t, tostring(it)) end end
	box.Text = (#t > 0) and table.concat(t, ", ") or "选择..."
end

local function rebuild()
	for _, c in ipairs(list:GetChildren()) do if c:IsA("TextButton") then c:Destroy() end end
	for _, it in ipairs(items) do
		local opt = newInstance("TextButton", { BackgroundColor3 = self.Tab.Window.Theme.Card, AutoButtonColor = false, Text = tostring(it), Font = self.Tab.Window.Theme.Font, TextSize = 14, TextColor3 = self.Tab.Window.Theme.Text, Size = UDim2.new(1, 0, 0, 28) })
		opt.Parent = list
		opt.MouseEnter:Connect(function() tween(opt, TweenInfo.new(0.12), { BackgroundColor3 = self.Tab.Window.Theme.Card2 }) end)
		opt.MouseLeave:Connect(function() tween(opt, TweenInfo.new(0.18), { BackgroundColor3 = self.Tab.Window.Theme.Card }) end)
		opt.MouseButton1Click:Connect(function()
			selected[it] = not selected[it]
			updateText()
			safeCall(cb, selected)
		end)
	end
	list.Size = UDim2.new(0, right.AbsoluteSize.X, 0, math.min(#items * 28, 160))
	updateText()
end

box.MouseButton1Click:Connect(function()
	list.Visible = not list.Visible
	rebuild()
	list.Position = UDim2.new(1, -right.AbsoluteSize.X, 0, holder.AbsoluteSize.Y + 6)
end)

local api = {
	Type = "MultiDropdown", Holder = holder,
	Get = function()
		local t = {}
		for _, it in ipairs(items) do if selected[it] then table.insert(t, it) end end
		return t
	end,
	Set = function(_, tbl)
		selected = {}
		for _, v in ipairs(tbl or {}) do selected[v] = true end
		updateText(); safeCall(cb, selected)
	end,
	SetItems = function(_, tbl) items = tbl or items; rebuild() end,
}
table.insert(self._controls, api)
self._saves[title] = function()
	local t = {}
	for k, v in pairs(selected) do if v then table.insert(t, k) end end
	return t
end
self._loads = self._loads or {}; self._loads[title] = function(v)
	selected = {}; for _, x in ipairs(v or {}) do selected[x] = true end; updateText()
end
return api

end

