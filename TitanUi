function Window:ApplyTheme(theme) self.Theme = deepMerge(self.Theme, theme or {}) -- 这里简单应用关键节点颜色；完整主题刷新应遍历所有控件，此处略作演示 self.Root.BackgroundColor3 = self.Theme.BG self.Content.BackgroundColor3 = self.Theme.Card end

function Window:Notify(opts) opts = opts or {} local Title = tostring(opts.Title or "Notice") local Message = tostring(opts.Message or "") local Duration = tonumber(opts.Duration or 3)

local card = newInstance("Frame", {
	BackgroundColor3 = self.Theme.Card2,
	Size = UDim2.new(1, 0, 0, 0),
	AutomaticSize = Enum.AutomaticSize.Y,
	BorderSizePixel = 0,
	ZIndex = 1001,
})
corner(self.Theme.Corner).Parent = card
stroke(applyTransparency(self.Theme.Stroke, 0.2), 1, 0.3).Parent = card
padding(10, 10, 10, 10).Parent = card
listLayout(Enum.FillDirection.Vertical, 4).Parent = card

local title = newInstance("TextLabel", {
	BackgroundTransparency = 1,
	Font = self.Theme.Font,
	TextSize = 15,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = self.Theme.Text,
	Text = Title,
	ZIndex = 1002,
})
title.Parent = card

local msg = newInstance("TextLabel", {
	BackgroundTransparency = 1,
	Font = self.Theme.Font,
	TextSize = 14,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextColor3 = self.Theme.SubText,
	TextWrapped = true,
	Text = Message,
	ZIndex = 1002,
})
msg.Parent = card

card.Parent = self.NotiRoot
card.Position = UDim2.new(1, 0, 0, 0)
card.AnchorPoint = Vector2.new(1, 0)
card.BackgroundTransparency = 0.2
tween(card, TweenInfo.new(0.15), { BackgroundColor3 = self.Theme.Card })

task.spawn(function()
	local t = 0
	local step = RunService.Heartbeat:Connect(function(dt) t += dt end)
	task.wait(Duration)
	step:Disconnect()
	tween(card, TweenInfo.new(0.25), { BackgroundTransparency = 1 })
	task.wait(0.25)
	card:Destroy()
end)

end

function Window:Save() local data = {} for _, t in ipairs(self._tabs) do if t._save then data[t.Title] = t:_save() end end local json = self.UILib.Storage:Save(data) self:Notify({ Title = "配置已保存", Message = "已复制到剪贴板 (JSON)", Duration = 3 }) return json end

function Window:Load(json) local data = self.UILib.Storage:Load(json) for _, t in ipairs(self._tabs) do if t._load then t:_load(data[t.Title]) end end self:Notify({ Title = "配置已载入", Message = "成功应用", Duration = 2 }) end

function Window:Destroy() if self._destroyed then return end self._destroyed = true self.UILib.Janitor:Cleanup() if self.UILib.Gui then self.UILib.Gui:Destroy() end end

function Window:Tab(opts) opts = opts or {} local title = tostring(opts.Title or ("Tab " .. tostring(#self._tabs + 1)))

-- Sidebar Button
local btn = newInstance("TextButton", {
	Name = "TabButton",
	BackgroundColor3 = self.Theme.Card2,
	AutoButtonColor = false,
	Text = title,
	Font = self.Theme.Font,
	TextSize = 14,
	TextColor3 = self.Theme.Text,
	Size = UDim2.new(1, 0, 0, 34),
	LayoutOrder = #self._tabs + 1,
})
corner(self.Theme.Corner).Parent = btn
stroke(applyTransparency(self.Theme.Stroke, 0.2), 1, 0.4).Parent = btn
btn.Parent = self.TabList

-- Content Page (ScrollingFrame)
local page = newInstance("ScrollingFrame", {
	Name = "Page",
	BackgroundTransparency = 1,
	ScrollBarThickness = 6,
	ScrollingDirection = Enum.ScrollingDirection.Y,
	AutomaticCanvasSize = Enum.AutomaticSize.Y,
	CanvasSize = UDim2.new(0, 0, 0, 0),
	Size = UDim2.new(1, 0, 1, 0),
	Visible = #self._tabs == 0,
})
page.Parent = self.Content
padding(12, 12, 12, 12).Parent = page
local layout = listLayout(Enum.FillDirection.Vertical, 10); layout.Parent = page

-- Hover effect
btn.MouseEnter:Connect(function()
	tween(btn, TweenInfo.new(0.12), { BackgroundColor3 = self.Theme.Card })
end)
btn.MouseLeave:Connect(function()
	if page.Visible then return end
	tween(btn, TweenInfo.new(0.2), { BackgroundColor3 = self.Theme.Card2 })
end)

-- Switch
btn.MouseButton1Click:Connect(function()
	for _, tab in ipairs(self._tabs) do
		tab._page.Visible = false
		tween(tab._button, TweenInfo.new(0.2), { BackgroundColor3 = self.Theme.Card2 })
	end
	page.Visible = true
	tween(btn, TweenInfo.new(0.2), { BackgroundColor3 = self.Theme.Card })
end)

local tab = setmetatable({
	__type = "Tab",
	Window = self,
	Title = title,
	_button = btn,
	_page = page,
	_sections = {},
	_saves = {},
}, Tab)

table.insert(self._tabs, tab)
if #self._tabs == 1 then
	page.Visible = true
	tween(btn, TweenInfo.new(0.2), { BackgroundColor3 = self.Theme.Card })
end
return tab

end

-- /////////////////////////////////////////////////////////////////// -- Tab Methods ------------------------------------------------------- function Tab:_save() local t = {} for _, s in ipairs(self._sections) do if s._save then t[s.Title] = s:_save() end end return t end

function Tab:_load(tbl) tbl = tbl or {} for _, s in ipairs(self._sections) do local d = tbl[s.Title] if s._load then s:_load(d) end end end

