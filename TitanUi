-- /////////////////////////////////////////////////////////////////// -- Controls Factory --------------------------------------------------- local function baseControl(section, height) local win = section.Tab.Window local holder = newInstance("Frame", { BackgroundColor3 = win.Theme.Card, BorderSizePixel = 0, Size = UDim2.new(1, 0, 0, height or 36), AutomaticSize = (section._grid and Enum.AutomaticSize.None) or Enum.AutomaticSize.None, }) corner(win.Theme.Corner).Parent = holder stroke(applyTransparency(win.Theme.Stroke, 0.2), 1, 0.35).Parent = holder padding(10, 8, 10, 8).Parent = holder listLayout(Enum.FillDirection.Horizontal, 8).Parent = holder holder.Parent = section.Content

return holder

end

local function makeLabel(parent, text, size, color) local l = newInstance("TextLabel", { BackgroundTransparency = 1, TextXAlignment = Enum.TextXAlignment.Left, Font = DefaultTheme.Font, TextSize = size or 14, TextColor3 = color or DefaultTheme.Text, Text = tostring(text or ""), Size = UDim2.new(1, 0, 1, 0), }) l.Parent = parent return l end

local function primaryButton(parent, theme) local b = newInstance("TextButton", { BackgroundColor3 = theme.Accent, AutoButtonColor = false, Text = "", TextTransparency = 0, TextColor3 = Color3.new(1, 1, 1), Font = theme.Font, TextSize = 14, Size = UDim2.fromOffset(80, 28), }) corner(theme.Corner).Parent = b stroke(applyTransparency(theme.Stroke, 0.2), 1, 0.2).Parent = b b.MouseEnter:Connect(function() tween(b, TweenInfo.new(0.12), { BackgroundColor3 = theme.Accent2 }) end) b.MouseLeave:Connect(function() tween(b, TweenInfo.new(0.18), { BackgroundColor3 = theme.Accent }) end) return b end

-- Button ------------------------------------------------------------ function Section:Button(opts) opts = opts or {} local title = tostring(opts.Title or "Button") local desc = opts.Desc and tostring(opts.Desc) or nil local cb = opts.Callback

local holder = baseControl(self, desc and 58 or 36)
local left = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -96, 1, 0) })
left.Parent = holder
listLayout(Enum.FillDirection.Vertical, 4).Parent = left

makeLabel(left, title, 14, self.Tab.Window.Theme.Text)
if desc then makeLabel(left, desc, 13, self.Tab.Window.Theme.SubText) end

local right = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(0, 96, 1, 0) })
right.Parent = holder
local btn = primaryButton(right, self.Tab.Window.Theme)
