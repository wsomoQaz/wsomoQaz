-- Slider ------------------------------------------------------------ function Section:Slider(opts) opts = opts or {} local title = tostring(opts.Title or "Slider") local desc = opts.Desc and tostring(opts.Desc) or nil local min = tonumber(opts.Min or 0) local max = tonumber(opts.Max or 100) local step = tonumber(opts.Step or 1) local default = tonumber(opts.Default or min) local unit = opts.Unit and tostring(opts.Unit) or "" local cb = opts.Callback

local holder = baseControl(self, desc and 72 or 50)
local left = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -96, 1, 0) })
left.Parent = holder
listLayout(Enum.FillDirection.Vertical, 4).Parent = left

local top = newInstance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18) })
top.Parent = left
listLayout(Enum.FillDirection.Horizontal, 8).Parent = top

local titleLbl = makeLabel(top, title, 14, self.Tab.Window.Theme.Text); titleLbl.Size = UDim2.new(1, -80, 1, 0)
local valueLbl = makeLabel(top, tostring(default) .. (unit ~= "" and (" " .. unit) or ""), 14, self.Tab.Window.Theme.SubText); valueLbl.Size = UDim2.new(0, 80, 1, 0)
valueLbl.TextXAlignment = Enum.TextXAlignment.Right

if desc then makeLabel(left, desc, 13, self.Tab.Window.Theme.SubText) end

local bar = newInstance("Frame", { BackgroundColor3 = self.Tab.Window.Theme.Card2, Size = UDim2.new(1, 0, 0, 10), BorderSizePixel = 0 })
corner(self.Tab.Window.Theme.Corner).Parent = bar
bar.Parent = left

local fill = newInstance("Frame", { BackgroundColor3 = self.Tab.Window.Theme.Accent, Size = UDim2.new(0, 0, 1, 0), BorderSizePixel = 0 })
corner(self.Tab.Window.Theme.Corner).Parent = fill
fill.Parent = bar

local dragging = false
local val = clamp(default, min, max)
local function render()
	local ratio = (val - min) / (max - min)
	fill.Size = UDim2.new(ratio, 0, 1, 0)
	valueLbl.Text = tostring(val) .. (unit ~= "" and (" " .. unit) or "")
end
render()

local function snap(x)
	return clamp(round(x, step), min, max)
end

bar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local abs = bar.AbsoluteSize.X
		local rel = clamp((input.Position.X - bar.AbsolutePosition.X) / abs, 0, 1)
		val = snap(min + rel * (max - min))
		render()
		safeCall(cb, val)
	end
end)

local api = { Type = "Slider", Holder = holder, Get = function() return val end, Set = function(_, v) val = snap(v or val); render(); safeCall(cb, val) end }
table.insert(self._controls, api)
self._saves[title] = function() return val end
self._loads = self._loads or {}; self._loads[title] = function(v) if tonumber(v) then val = snap(v); render() end end
return api

end

