-- Utility ------------------------------------------------------ local function safeCall(fn, ...) local ok, res = pcall(fn, ...) if not ok then warn("[UILib] Callback Error:", res) end return ok, res end

local function deepMerge(a, b) local t = {} for k, v in pairs(a or {}) do t[k] = v end for k, v in pairs(b or {}) do if type(v) == "table" and type(t[k]) == "table" then t[k] = deepMerge(t[k], v) else t[k] = v end end return t end

local function clamp(n, mi, ma) return math.clamp(n, mi, ma) end

local function lerp(a, b, t) return a + (b - a) * t end

local function newInstance(class, props, children) local obj = Instance.new(class) if props then for k, v in pairs(props) do obj[k] = v end end if children then for _, c in ipairs(children) do c.Parent = obj end end return obj end

local function round(n, step) step = step or 1 return math.floor((n / step) + 0.5) * step end

local function textSize(txt, font, size, width) local bounds = TextService:GetTextSize(txt or "", size or 14, font or Enum.Font.Ubuntu, Vector2.new(width or 1000, 1e5)) return bounds end

local function makeSignal() local bind = Instance.new("BindableEvent") return { Connect = function(, fn) return bind.Event:Connect(fn) end, Fire = function(, ...) bind:Fire(...) end, Destroy = function(_) bind:Destroy() end, } end

-- Theme -------------------------------------------------------- local DefaultTheme = { Font = Enum.Font.Ubuntu, TextSize = 14, Corner = 10, Shadow = true, Transparency = 0, -- 全局透明叠加 0~0.5

Accent = Color3.fromRGB(10, 132, 255),
Accent2 = Color3.fromRGB(64, 156, 255),
BG = Color3.fromRGB(16, 18, 28),
Card = Color3.fromRGB(22, 24, 36),
Card2 = Color3.fromRGB(28, 30, 44),
Stroke = Color3.fromRGB(50, 55, 78),
Text = Color3.fromRGB(230, 235, 245),
SubText = Color3.fromRGB(160, 170, 190),
Good = Color3.fromRGB(34, 197, 94),
Warn = Color3.fromRGB(234, 179, 8),
Bad = Color3.fromRGB(239, 68, 68),

}

local function applyTransparency(color, t) local r, g, b = color.R, color.G, color.B local bg = Color3.new(0, 0, 0) return Color3.new(lerp(r, bg.R, t), lerp(g, bg.G, t), lerp(b, bg.B, t)) end

-- Janitor ------------------------------------------------------ local Janitor = {} Janitor.__index = Janitor function Janitor.new() return setmetatable({ list = {} }, Janitor) end function Janitor:Add(obj, fn) self.list[#self.list + 1] = { obj = obj, fn = fn } return obj end function Janitor:Link(conn) return self:Add(conn, function(c) if c.Disconnect then c:Disconnect() else pcall(function() c:Destroy() end) end end) end function Janitor:Cleanup() for i = #self.list, 1, -1 do local item = self.list[i] local ok, err = pcall(function() if item.fn then item.fn(item.obj) elseif typeof(item.obj) == "RBXScriptConnection" then item.obj:Disconnect() elseif typeof(item.obj) == "Instance" then item.obj:Destroy() end end) if not ok then warn("[UILib] Cleanup error:", err) end self.list[i] = nil end end function Janitor:Destroy() self:Cleanup() end

-- Style Helpers ----------------------------------------------- local function corner(radius) return newInstance("UICorner", { CornerRadius = UDim.new(0, radius or DefaultTheme.Corner) }) end

local function stroke(color, thickness, transparency) return newInstance("UIStroke", { ApplyStrokeMode = Enum.ApplyStrokeMode.Border, LineJoinMode = Enum.LineJoinMode.Round, Thickness = thickness or 1, Color = color or DefaultTheme.Stroke, Transparency = transparency or 0.25, }) end

local function padding(l, t, r, b) return newInstance("UIPadding", { PaddingLeft = UDim.new(0, l or 8), PaddingTop = UDim.new(0, t or 8), PaddingRight = UDim.new(0, r or 8), PaddingBottom = UDim.new(0, b or 8) }) end

local function listLayout(dir, paddingPx) return newInstance("UIListLayout", { FillDirection = dir or Enum.FillDirection.Vertical, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, paddingPx or 6), }) end

local function gridLayout(cellSize, cellPad) return newInstance("UIGridLayout", { CellSize = cellSize or UDim2.new(0, 140, 0, 36), CellPadding = cellPad or UDim2.new(0, 8, 0, 8), SortOrder = Enum.SortOrder.LayoutOrder, }) end

-- Tween Helpers ----------------------------------------------- local function tween(o, info, props) local t = TweenService:Create(o, info or TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props) t:Play() return t end

-- Color Utils -------------------------------------------------- local function rgbToHsv(c) local h, s, v = Color3.toHSV(c) return h, s, v end

local function hsvToRgb(h, s, v) return Color3.fromHSV(h, s, v) end

-- Storage ------------------------------------------------------ local Storage = {} Storage.__index = Storage function Storage.new(key) return setmetatable({ key = key or ("UILib-" .. tostring(math.random(100000, 999999))) }, Storage) end function Storage:Encode(tbl) return HttpService:JSONEncode(tbl) end function Storage:Decode(str) local ok, data = pcall(function() return HttpService:JSONDecode(str) end) if ok and type(data) == "table" then return data end return {} end function Storage:Save(tbl) local json = self:Encode(tbl) -- 由于通用环境限制，这里提供剪贴板导出；开发者可改成 DataStoreService pcall(setclipboard, json) return json end function Storage:Load(str) if not str or #str == 0 then return {} end return self:Decode(str) end

-- Root UI ------------------------------------------------------ local function createRootGui(name) local PlayerGui = Players.LocalPlayer and Players.LocalPlayer:FindFirstChildOfClass("PlayerGui") if not PlayerGui then PlayerGui = newInstance("ScreenGui", { Name = name, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false }) PlayerGui.Parent = Players.LocalPlayer:WaitForChild("PlayerGui") else local existing = PlayerGui:FindFirstChild(name) if existing then existing:Destroy() end local sg = newInstance("ScreenGui", { Name = name, ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, IgnoreGuiInset = false }) sg.Parent = PlayerGui end return PlayerGui:FindFirstChild(name) end

