-- Dragging & Resize
local dragging = false
local dragOffset
local function beginDrag(input)
	dragging = true
	dragOffset = input.Position - Root.AbsolutePosition
end
local function endDrag()
	dragging = false
end
selfLib.Janitor:Link(TitleBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then beginDrag(input) end
end))
selfLib.Janitor:Link(UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then endDrag() end
end))
selfLib.Janitor:Link(UserInputService.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local pos = input.Position - dragOffset
		Root.Position = UDim2.fromOffset(math.max(8, pos.X), math.max(8, pos.Y))
	end
end))

